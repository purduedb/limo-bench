# Copy to .env - server.ts loads it automatically via dotenv, and tests/ relies on this too.

DB_NAME=osm
DB_USER=your_username
DB_HOST=localhost
DB_PORT=5432

# Started via `make photon_up` / `make graphhopper_up` (see services/)
PHOTON_URL=http://127.0.0.1:2322
GRAPHHOPPER_URL=http://127.0.0.1:8989

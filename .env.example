# Shared configuration for benchmark runners. Copy to .env.
# Leave unused keys empty. Shell environment variables take precedence.
# Endpoint overrides are optional; standard provider URLs are used by default.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (default provider) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Purdue GenAI Studio - https://www.rcac.purdue.edu/knowledge/genaistudio
GENAI_API_KEY=

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional endpoint overrides (used by runners)
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GENAI_BASE_URL=https://genai.rcac.purdue.edu/api
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Maps Platform (only for MCP_VENDOR=cablate/mcp-google-map) — https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
